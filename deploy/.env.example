# Copy to .env and fill in. Never commit this file.
# Generate secrets with:  openssl rand -hex 32
# (deploy/setup.ps1 on Windows and deploy/setup.sh on Linux fill DB_PASSWORD,
#  APP_REMEMBER_ME_KEY and — on Linux, once Tailscale is up — STRAVA_REDIRECT_URI.)

# Database password (internal only, pick something random)
DB_PASSWORD=

# Login for the app itself
APP_USERNAME=wout
APP_PASSWORD=
# Keep this stable, otherwise everyone is logged out after a restart
APP_REMEMBER_ME_KEY=

# Strava API app (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match the Authorization Callback Domain in Strava, with /callback
STRAVA_REDIRECT_URI=https://YOUR-MACHINE.YOUR-TAILNET.ts.net/callback

# Optional: Garmin personal API key
GARMIN_PERSONAL_API_KEY=

# --- AI answer in the app (optional, free OpenRouter tier) ---------------------
# Blank AI_API_KEY = feature off: no outbound call, no AI button, prompt page unchanged.
# Free key: https://openrouter.ai/ → sign in → Keys → Create key (no card needed).
# Keep AI_MODEL on a model whose ID ends in ":free"; anything else can bill your account.
AI_API_KEY=
AI_ENABLED=true
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=particle-ai/particle-1:free
AI_PROVIDER_NAME=OpenRouter
# Details, free-tier limits and how to switch provider: docs/ai-integration.md

# --- Multi-user (other people with their own account) -------------------------
# Leave the switch on false until you have read MULTI_USER_PROGRESS.md and made a back-up
# (bash deploy/backup.sh). With false the app behaves exactly as before.
APP_MULTI_USER_ENABLED=false
# Your own master invite code for /register (at least 16 characters, keep it secret). Blank = signup off.
# On /admin/users you make single-use codes to hand out; this master code keeps working too.
APP_SIGNUP_CODE=
# Encrypts the Garmin keys of other users. Base64 of 32 random bytes:  openssl rand -base64 32
# Never change or lose it once users have stored a key: their keys cannot be read without it.
APP_TENANT_SECRET_KEY=
# Optional: JDBC URL of the control database. Blank = same server, database running_control.
# APP_CONTROL_DB_URL=

# Timezone for the 06:00 and 06:30 sync jobs
TZ=Europe/Brussels

# Host port of the app (start.sh picks the next free port by itself if this one is taken)
# APP_PORT=8080
